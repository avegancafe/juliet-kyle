{
  "model": "opus",
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "beadwork@avegancafe-marketplace": {
      "options": {
        "openOnStart": true
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "verbose": true,
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "allow": [
      "mcp__claude_ai_Linear__get_issue",
      "mcp__a76988b1-f010-48b5-9352-fa81ef3a2e27__get_issue",
      "mcp__notion__notion-search",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-get-comments",
      "mcp__notion__notion-get-teams",
      "mcp__notion__notion-get-users",
      "mcp__claude_ai_Granola__*"
    ],
    "defaultMode": "plan"
  },
  "enabledPlugins": {
    "kitchen-brigade@avegancafe-marketplace": true,
    "beadwork@avegancafe-marketplace": true,
    "avegancafe@avegancafe-marketplace": true,
    "session-management@avegancafe-marketplace": true,
    "j2-presentations@j2-claude-plugins": true,
    "python-lsp@j2-claude-plugins": true,
    "typescript-lsp@j2-claude-plugins": true,
    "j2-eng@j2-claude-plugins": true,
    "superpowers@j2-claude-plugins": true,
    "codex@j2-claude-plugins": true,
    "dbt@j2-claude-plugins": true,
    "playwright@j2-claude-plugins": true,
    "mattpocock-skills@j2-claude-plugins": true,
    "launchdarkly@j2-claude-plugins": true,
    "in-my-voice@j2-claude-plugins": true,
    "j2-sandbox@j2-claude-plugins": true,
    "typesafe@j2-claude-plugins": true,
    "diagram-design@j2-claude-plugins": true,
    "compliance@j2-claude-plugins": true,
    "sentry@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "avegancafe-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/avegancafe/avegancafe-marketplace.git"
      },
