#!/usr/bin/env python3
"""Chromium native-messaging host for the "Duet links in Zen" extension.

Reads one {"url": ...} message and opens it with xdg-open (the default
browser, Zen). Only http(s) URLs are accepted.
"""
import json
import struct
import subprocess
import sys


def reply(obj):
    data = json.dumps(obj).encode()
    sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
    sys.stdout.buffer.flush()


header = sys.stdin.buffer.read(4)
if len(header) != 4:
    sys.exit(0)
(length,) = struct.unpack("=I", header)
url = json.loads(sys.stdin.buffer.read(length)).get("url", "")

if not url.startswith(("https://", "http://")):
    reply({"ok": False, "error": "not an http(s) url"})
    sys.exit(0)

subprocess.Popen(
    ["xdg-open", url],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    start_new_session=True,  # keep running after Chromium closes the host
)
reply({"ok": True})
