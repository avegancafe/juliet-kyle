[Desktop Entry]
# Managed by juliet-kyle. Opens Claude Duet at login, next to the Ghostty that
# niri starts. Juliet's niri window rule puts it on the "coding" workspace.
Type=Application
Name=Claude Duet
Comment=Claude Duet in its own Chromium app window
Exec=chromium-browser --app=https://claude.ai/duet
Icon=chromium-browser
Categories=Network;Chat;
StartupWMClass=chrome-claude.ai__duet-Default
TryExec=chromium-browser
