# Keys this setup reads from ~/.config/local/.env. juliet-bootstrap appends any
# that are missing there and never overwrites values already set. Values here
# are committed: keep secrets blank. Format: NAME=value, no quotes, comments in
# column 1. (Juliet's own .env.template already covers JULIET_EXTENSION and the
# shared tool tokens.)

# Hammerspoon ctrl+space: Rex when installed, else Ghostty.
JULIET_TERMINALS=com.superlogical.rex,com.mitchellh.ghostty
